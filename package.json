{
  "name": "@virtual-search/core",
  "version": "0.2.0",
  "description": "Virtualized list with hybrid height estimation, full-text search across all data, and scroll-to-match with highlight",
  "type": "module",
  "author": "Dominik Pawlikowski",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "cross-env BUILD_MODE=lib vite build && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@tanstack/react-virtual": "^3.10.0",
    "idb": "^8.0.0",
    "minisearch": "^7.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dpawlikowski/virtual-search"
  },
  "homepage": "https://github.com/dpawlikowski/virtual-search#readme",
  "bugs": {
    "url": "https://github.com/dpawlikowski/virtual-search/issues"
  },
  "keywords": [
    "react",
    "virtualization",
    "virtual-list",
    "search",
    "full-text-search",
    "height-estimation",
    "pretext",
    "scroll-to-match",
    "ctrl-f",
    "highlight",
    "regex-search",
    "minimap"
  ],
  "license": "MIT"
}
